stateDiagram-v2
  [*] --> browsing
  browsing: browsing
  cart: the cart
  promo: typing a code
  applied: code applied
  rejected: code rejected
  address: address
  shipping: delivery
  review: review the order
  payment: payment
  authorising: asking the bank
  challenge: 3-D Secure check
  declined: card declined
  placed: order placed
  emailed: receipt sent
  packing: packing
  shipped: shipped
  timed_out: timed out
  cancelled: cancelled
  browsing --> cart: view cart
  cart --> cart: add item
  cart --> browsing: keep shopping
  cart --> promo: enter a code [has items]
  promo --> applied: good code
  promo --> rejected: bad code
  rejected --> promo: try again
  rejected --> address: skip the code [has items]
  applied --> address: continue [has items]
  cart --> address: check out [has items]
  address --> shipping: save address
  shipping --> review: choose delivery
  review --> payment: confirm
  payment --> authorising: pay
  payment --> timed_out: wait 15 min
  timed_out --> cart: start again
  authorising --> challenge: bank asks
  challenge --> authorising: approve in app
  authorising --> authorising: bank says yes
  authorising --> declined: bank says no
  authorising --> placed: place order [card approved]
  declined --> payment: try another card [tries left]
  declined --> cancelled: give up
  placed --> emailed: send receipt
  emailed --> packing: pick and pack
  packing --> shipped: hand to courier
  shipped --> [*]
  cancelled --> [*]
