  src --> barrel: [from the barrel]
  src --> mains: [else]
  mains --> use: follow it
  barrel --> use: follow it
  use --> shower: [to the shower]
  use --> toilet: [to the toilet]
  use --> washer: [to the washer]
  use --> kitchen: [to the kitchen]
  use --> garden: [else]
  shower --> sewer: down the drain
  toilet --> sewer: down the drain
  washer --> sewer: down the drain
  kitchen --> sewer: down the drain
  garden --> soil: into the soil
  sewer --> meter: back to the meter
  soil --> meter: back to the meter
